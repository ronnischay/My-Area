# Backend environment (copy to apps/backend/.env). Placeholders only — never commit real values.
# Parsed and validated by src/config/env.ts; the server refuses to start on invalid values.
# Values in code are only local-development defaults; secrets have no default and must be set here.

# --- Server -------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (CORS + same-origin check on POST/PATCH/DELETE).
FRONTEND_ORIGIN=http://localhost:3000
# debug | info | warn | error | silent
LOG_LEVEL=info

# --- Database (required) --------------------------------------------------------
DATABASE_URL=postgres://<user>@localhost:5432/myarea_dev
# Integration tests only; must differ from DATABASE_URL (tests empty its tables).
DATABASE_URL_TEST=postgres://<user>@localhost:5432/myarea_test

# --- Auth + invites -------------------------------------------------------------
# Public frontend URL used in invite links.
APP_URL=http://localhost:3000
# Sessions need no secret: tokens are random and stored hashed (docs/features/auth.md).

# --- Demo data (npm run db:seed; development only) ----------------------------
# Password for every demo account the seed creates. At least 10 characters.
SEED_PASSWORD=<choose-a-dev-password>

# --- Email ----------------------------------------------------------------------
# smtp | console   (console prints emails to the log; refused when NODE_ENV=production)
EMAIL_PROVIDER=console
EMAIL_FROM="MyArea <no-reply@example.com>"
# Required when EMAIL_PROVIDER=smtp. SMTP_SECURE=true for port 465, false for 587 (STARTTLS).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=<smtp-user>
# SMTP_PASS=<smtp-password>

# --- Report photos ----------------------------------------------------------------
# Photos are stored on this server's disk (D021) and served only to signed-in society members.
# Relative paths resolve from apps/backend. Back this folder up together with the database.
UPLOAD_DIR=uploads
# Cloudinary is not used yet. If it is added later, its settings will be documented here.

# --- Phase 5: new-report email (not read yet) --------------------------------
# ISSUE_MANAGEMENT_EMAIL=issues@example.com
