# Backend environment (copy to apps/backend/.env). Placeholders only — never commit real values.
# Parsed and validated by src/config/env.ts; the server refuses to start on invalid values.

# --- Phase 1: server ---------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (CORS).
FRONTEND_ORIGIN=http://localhost:3000
# debug | info | warn | error | silent
LOG_LEVEL=info

# --- Phase 2: database (not read yet) ----------------------------------------
# DATABASE_URL=postgres://<user>@localhost:5432/myarea_dev
# DATABASE_URL_TEST=postgres://<user>@localhost:5432/myarea_test

# --- Phase 3: media (not read yet) -------------------------------------------
# CLOUDINARY_CLOUD_NAME=<cloud-name>
# CLOUDINARY_API_KEY=<api-key>
# CLOUDINARY_API_SECRET=<api-secret>
# CLOUDINARY_FOLDER=myarea/dev

# --- Phase 4: email (not read yet; one provider only) -------------------------
# ISSUE_MANAGEMENT_EMAIL=issues@example.com
# EMAIL_FROM="MyArea <no-reply@example.com>"
# RESEND_API_KEY=<resend-api-key>
# or SMTP_HOST= / SMTP_PORT= / SMTP_USER= / SMTP_PASS=

# --- Phase 6: manager auth (decided at Phase 6, see docs/DECISIONS.md D006) ---
# MANAGER_API_TOKEN=<long-random-token>   # Option A (demo only)
# SESSION_SECRET=<long-random-secret>     # Option B
