# Backend environment (copy to apps/backend/.env). Placeholders only — never commit real values.
# Parsed and validated by src/config/env.ts; the server refuses to start on invalid values.
# Values in code are only local-development defaults; secrets have no default and must be set here.

# --- Server -------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (CORS + same-origin check on POST/PATCH/DELETE).
FRONTEND_ORIGIN=http://localhost:3000
# debug | info | warn | error | silent
LOG_LEVEL=info

# --- Database (required) --------------------------------------------------------
DATABASE_URL=postgres://<user>@localhost:5432/myarea_dev
# Integration tests only; must differ from DATABASE_URL (tests empty its tables).
DATABASE_URL_TEST=postgres://<user>@localhost:5432/myarea_test

# --- Auth + invites -------------------------------------------------------------
# Public frontend URL used in invite links.
APP_URL=http://localhost:3000
# Sessions need no secret: tokens are random and stored hashed (docs/features/auth.md).

# --- Demo data (npm run db:seed; development only) ----------------------------
# Password for every demo account the seed creates. At least 10 characters.
SEED_PASSWORD=<choose-a-dev-password>

# --- Forgot password ------------------------------------------------------------
# Signs password-reset links (they need no database table). Required in production: at least 32
# random characters, e.g. `openssl rand -base64 48`. Changing it cancels every pending reset link.
# Unset outside production: a random secret per run (links stop working after a restart).
# PASSWORD_RESET_SECRET=<random-string-of-32+-characters>

# --- Email ----------------------------------------------------------------------
# Invites go to the invited member; new-report emails go to the society's managers.
# smtp | brevo | console   (console prints emails to the log; refused when NODE_ENV=production)
# EMAIL_FROM must be an address your provider accepts (for Brevo: a verified sender).
EMAIL_PROVIDER=console
EMAIL_FROM="MyArea <no-reply@example.com>"
# Required when EMAIL_PROVIDER=smtp. SMTP_SECURE=true for port 465, false for 587 (STARTTLS).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=<smtp-user>
# SMTP_PASS=<smtp-password>
# Required when EMAIL_PROVIDER=brevo: Brevo's HTTPS API, for hosts that block SMTP ports
# (e.g. Render's free plan). Create the key in Brevo under SMTP & API > API Keys.
# BREVO_API_KEY=<brevo-api-key>

# --- Report photos ----------------------------------------------------------------
# Photos are stored on this server's disk (D021) and served only to signed-in society members.
# Relative paths resolve from apps/backend. Back this folder up together with the database.
UPLOAD_DIR=uploads
# Cloudinary is not used yet. If it is added later, its settings will be documented here.

# --- AI suggestions on the report form (optional) --------------------------------------
# Google Gemini (free tier works). Without a key the "Suggest" button is hidden.
# Get a key in Google AI Studio; keep it only in this git-ignored file.
# GEMINI_API_KEY=<your-gemini-api-key>
# GEMINI_MODEL=gemini-3.5-flash-lite

